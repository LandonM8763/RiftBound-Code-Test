{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      // Pattern rather than one entry per package, so adding a package needs no
      // edit here. TypeScript prefers an exact match over a pattern, which is
      // why the subpath export below still resolves correctly.
      "@riftbound/*": ["./packages/*/src/index.ts"],
      "@riftbound/cards/testing": ["./packages/cards/src/testing.ts"]
    }
  },
  "include": ["packages/*/src/**/*"]
}
